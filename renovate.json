{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Baku",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "commitMessagePrefix": "build(deps):",
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "matchDepTypes": ["dependencies"],
      "groupName": "production dependencies (in-range)",
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies (in-range)",
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "prPriority": -1
    },
    {
      "matchPackageNames": ["bull"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "dependencyDashboard": true
}
